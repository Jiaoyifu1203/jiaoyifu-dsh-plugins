{
  "name": "deepseek-harness-local",
  "private": true,
  "description": "Local launcher for DeepSeek Harness + Pi. Secrets stay in DEEPSEEK_API_KEY.",
  "scripts": {
    "dsh": "npx --yes --prefer-offline @deepseek-ai/dsh@0.1.0-rc.7",
    "dsh:web": "npx --yes --prefer-offline @deepseek-ai/dsh@0.1.0-rc.7 --profile web",
    "dsh:help": "npx --yes --prefer-offline @deepseek-ai/dsh@0.1.0-rc.7 --help",
    "pi": "pi",
    "verify": "bash scripts/verify.sh",
    "check:plugins": "node scripts/plugin-check.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "dsh-better-sidebar": "0.13.0",
    "dsh-video-preview": "0.1.1",
    "jiaoyifu-studio": "file:plugins/jiaoyifu-studio",
    "widget-dock": "1.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
