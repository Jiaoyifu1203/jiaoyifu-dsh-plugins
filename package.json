{
  "name": "deepseek-harness-local",
  "private": true,
  "description": "Local launcher for DeepSeek Harness + Pi. Secrets stay in DEEPSEEK_API_KEY.",
  "scripts": {
    "dsh": "npx --yes @deepseek-ai/dsh",
    "dsh:web": "npx --yes @deepseek-ai/dsh web",
    "dsh:help": "npx --yes @deepseek-ai/dsh --help",
    "pi": "pi",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@larksuiteoapi/node-sdk": "^1.73.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
